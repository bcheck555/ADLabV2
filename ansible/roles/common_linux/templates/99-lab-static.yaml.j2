network:
  version: 2
  ethernets:
    eth0:
      dhcp4: false
      addresses:
        - {{ ansible_host }}/{{ lab_prefix_len }}
      routes:
        - to: default
          via: {{ lab_gateway }}
      nameservers:
        addresses:
          - {{ lab_dns1 }}
          - {{ lab_dns2 }}
          - 8.8.8.8
