#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    network:
      version: 2
      ethernets:
        primary:
          match:
            name: "e*"
          addresses:
            - 10.0.0.2/24
          routes:
            - to: default
              via: 10.0.0.1
          nameservers:
            addresses:
              - 10.0.0.1
  apt:
    disable_components: []
    geoip: false
    preserve_sources_list: true
    fallback: offline-install
  storage:
    layout:
      name: direct
  identity:
    hostname: ubuntu-packer
    username: labadmin
    password: ${password_hash}
  ssh:
    install-server: true
    allow-pw: true
  late-commands:
    # Belt-and-suspenders: force-set the password and ensure account is unlocked
    - curtin in-target --target=/target -- passwd -u labadmin || true
    # Allow labadmin passwordless sudo for Ansible
    - echo 'labadmin ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/labadmin
    - chmod 440 /target/etc/sudoers.d/labadmin
    # Ensure sshd permits password auth
    - curtin in-target --target=/target -- sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    - curtin in-target --target=/target -- bash -c "echo 'PasswordAuthentication yes' > /etc/ssh/sshd_config.d/60-packer.conf"
    # Disable apt timers that would fail with no internet
    - curtin in-target --target=/target -- systemctl disable apt-daily.timer apt-daily-upgrade.timer || true
    - curtin in-target --target=/target -- systemctl mask apt-daily.service apt-daily-upgrade.service || true
  user-data:
    disable_root: true

